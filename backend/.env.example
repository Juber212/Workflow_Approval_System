# 智展研究院设计开发管理系统 — 环境变量模板
# 复制为 .env 后修改

# 应用
APP_NAME=智展研究院设计开发管理系统
DEBUG=true
# 运行环境（development / test / prod）。生产部署须设为 prod（触发生产守卫：
# DEBUG=true 拒启动 + SECRET_KEY 强制强密钥）；本地开发保持 development 即可。
ENV=development

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=workflow_approval

# 测试库（MySQL 真实测试 fixture 复用主库凭据，仅库名不同）
TEST_DB_NAME=workflow_approval_test

# JWT —— 生产必须替换为随机强密钥（ENV=prod 时生产守卫拒绝已知默认值）
# 生成方式：openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis（硬依赖：DB0 任务队列 / DB1 PubSub 桥接 / DB2 Token 黑名单）
REDIS_URL=redis://localhost:6379/0
REDIS_ARQ_DB=0
REDIS_PUBSUB_DB=1

# 默认密码（生产守卫必填，未配置拒启动）
# DEFAULT_USER_PASSWORD：管理员「重置密码」时把用户密码重置为该值，不配置则重置会失败
DEFAULT_USER_PASSWORD=change-me-user-default
# DEFAULT_ADMIN_PASSWORD：首次部署 python -m app.core.seed 创建 admin 时使用
DEFAULT_ADMIN_PASSWORD=change-me-admin-default

# 文件存储（相对 backend/ 目录）
STORAGE_ROOT=storage
LIBREOFFICE_PATH=soffice

# 存储子目录（支持中文命名）
PROJECT_ARCHIVE_DIR=项目
PROPOSAL_ARCHIVE_DIR=方案
STORAGE_SIGNATURES_DIR=signatures
STORAGE_DOCUMENT_TEMPLATES_DIR=document_templates

# 文件上传限制
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg,image/jpg

# PDF 签名默认参数
PDF_SIGNATURE_X=400
PDF_SIGNATURE_Y=100
PDF_SIGNATURE_OFFSET=150
PDF_SIGNATURE_PAGE=-1
PDF_SIGNATURE_MAX_WIDTH=100
PDF_SIGNATURE_MAX_HEIGHT=26

# CORS
CORS_ORIGINS=http://localhost:5173
